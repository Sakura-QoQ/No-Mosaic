<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1.0.1</Version>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MosaicAssetPatch</AssemblyName>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\third_party\AssetsTools.NET\classdata.tpk" Link="classdata.tpk"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Reference Include="AssetsTools.NET">
      <HintPath>..\..\third_party\AssetsTools.NET\AssetsTools.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
